{
  "manifest_version": 3,
  "name": "Revisions Editor Bridge",
  "version": "1.4.0",
  "description": "Sends Google Docs manuscripts to the Revisions Editor desktop app and applies merged review edits back to Google Docs.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite",
    "identity"
  ],
  "host_permissions": [
    "https://docs.google.com/*",
    "https://docs.googleapis.com/*",
    "https://*.googleusercontent.com/*",
    "http://127.0.0.1:17420/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Revisions Editor Bridge"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/document/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
