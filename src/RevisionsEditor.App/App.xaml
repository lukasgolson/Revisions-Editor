<Application x:Class="RevisionsEditor.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="System"
             ShutdownMode="OnMainWindowClose">
    <!--
        The Windows 11 Fluent theme supplies every control template and follows the system
        light/dark mode and accent color. Only layout helpers are defined here; colors always
        come from theme resources so the app stays consistent with Windows.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
            <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

            <!-- Icon glyph used in menus, toolbars and the status bar -->
            <Style x:Key="IconGlyph" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>

            <!-- Text label next to an icon inside a toolbar button -->
            <Style x:Key="ToolBarLabel" TargetType="TextBlock">
                <Setter Property="Margin" Value="6,0,0,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- Title of a pane or a region inside a tab -->
            <Style x:Key="PaneHeader" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="12,10,12,6"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            </Style>

            <Style x:Key="SecondaryText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- Strip of commands at the top of a pane or tab, separated from the content by a divider -->
            <Style x:Key="CommandStrip" TargetType="Border">
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
            </Style>

            <Style x:Key="FooterStrip" TargetType="Border" BasedOn="{StaticResource CommandStrip}">
                <Setter Property="BorderThickness" Value="0,1,0,0"/>
            </Style>

            <!-- Docked side pane surface -->
            <Style x:Key="PaneSurface" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <Style x:Key="PaneSplitter" TargetType="GridSplitter">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="Focusable" Value="False"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
