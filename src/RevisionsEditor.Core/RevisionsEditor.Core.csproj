<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Vector figures: SVG is drawn with Skia (to PDF for LaTeX, to PNG for Word and the preview); PDF figures are
         rendered with PDFium for the preview and Word. -->
    <PackageReference Include="Svg.Skia" Version="5.2.3" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <!-- Git inside the app (libgit2): launching git.exe costs from a quarter to a full second per command on
         managed Windows machines. The git program is still used to fetch from and push to GitHub. -->
    <PackageReference Include="LibGit2Sharp" Version="0.31.0" />
    <!-- Layered graph layout with crossing minimisation and routed edges (Microsoft Research MSAGL), for diagrams laid out automatically ("layout auto"). -->
    <PackageReference Include="AutomaticGraphLayout" Version="1.1.12" />
  </ItemGroup>
</Project>
